server {
  listen 80;
  root /usr/share/nginx/html;
  client_max_body_size 20m;

  location /api/ {
    proxy_pass ${TANDOOR_URL};
    proxy_ssl_server_name on;
  }
  location /media/ {
    proxy_pass ${TANDOOR_URL};
    proxy_ssl_server_name on;
  }
  location / {
    try_files $uri /index.html;
  }
}
